PORT=3001
DATABASE_URL=postgresql://dls:replace-password@127.0.0.1:55432/dynamic_life
DB_POOL_MAX=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-new-strong-password
# Set NODE_ENV=production on Railway (HTTPS secure cookies).
# Optional trusted CA PEM for a provider requiring a private certificate authority:
# DATABASE_CA=

# Required for encrypted SMTP credentials (generate a random value of at least 32 characters).
# Keep the same key when moving a database backup to a new server.
MAIL_ENCRYPTION_KEY=

# Stable secret for encrypted gateway credentials (keep with private backups).
# Falls back to MAIL_ENCRYPTION_KEY when unset. Use at least 32 random characters.
PAYMENT_ENCRYPTION_KEY=
